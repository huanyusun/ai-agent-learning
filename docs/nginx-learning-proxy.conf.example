# 学习中心自有域名代理加速:nginx 参考配置
#
# 用法(把 learning.example.com 换成你的域名):
#   1) DNS:你的域名 A/AAAA 记录解析到这台服务器 IP
#   2) 证书:certbot --nginx -d learning.example.com  (或自行放置证书后改路径)
#   3) 放置本文件到 /etc/nginx/conf.d/learning-proxy.conf 并 nginx -s reload
#
# 原理:你的域名 → 你的服务器 → 反向代理 GitHub Pages
#   https://huanyusun.github.io/ai-agent-learning/
# 由此在国内网络走你自己服务器的线路,实现加速;站点更新仍由 Pages 工作流自动发布。

server {
    listen 80;
    server_name learning.example.com;
    # certbot 续期用;签好证书后建议整体重定向到 https
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name learning.example.com;

    ssl_certificate     /etc/letsencrypt/live/learning.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learning.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 站点根:域名根路径映射到 Pages 的 /ai-agent-learning/ 子路径
    location / {
        proxy_pass https://huanyusun.github.io/ai-agent-learning/;
        proxy_set_header Host huanyusun.github.io;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_http_version 1.1;

        # Pages 内容不可变,可放心缓存;缓存可选,去掉即实时回源
        proxy_cache_valid 200 10m;
        expires 10m;
        add_header Cache-Control "public, max-age=600";

        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # GitHub Pages 会有少量 302/404(如仓库代码链接),原样透传
    proxy_intercept_errors off;
}
